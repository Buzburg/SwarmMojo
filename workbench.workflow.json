{
  "version": 1,
  "max_seconds": 180,
  "steps": [
    {
      "id": "verify-integrations",
      "command": [
        "{python}",
        "-m",
        "scripts.verify_workbench"
      ],
      "verify": [
        "{python}",
        "-m",
        "scripts.verify_workbench",
        "--check-report",
        "build/workbench-tests.json"
      ],
      "needs": [],
      "inputs": [
        ".gitattributes",
        "app/config.py",
        "app/container_runner.py",
        "app/git_workspace.py",
        "app/goose_response.py",
        "app/patch_promotion.py",
        "app/patch_tasks.py",
        "app/source_library.py",
        "app/validation_policy.py",
        "app/workbench/__init__.py",
        "app/workbench/baseline.py",
        "app/workbench/builds.py",
        "app/workbench/context.py",
        "app/workbench/integrations.py",
        "app/workbench/qualification.py",
        "app/workbench/receipts.py",
        "app/workbench/state.py",
        "app/workbench/vendor/SOURCES.json",
        "app/workbench/vendor/__init__.py",
        "app/workbench/vendor/mojo-sieve-LICENSE",
        "app/workbench/vendor/mojo-symdex-LICENSE",
        "app/workbench/vendor/sieve.py",
        "app/workbench/vendor/symdex.py",
        "app/workbench/vendor/traceseal/LICENSE",
        "app/workbench/vendor/traceseal/NOTICE",
        "app/workbench/vendor/traceseal/__init__.py",
        "app/workbench/vendor/traceseal/_support.py",
        "app/workbench/vendor/traceseal/core.py",
        "app/workbench/vendor/workflowproof/LICENSE",
        "app/workbench/vendor/workflowproof/NOTICE",
        "app/workbench/vendor/workflowproof/__init__.py",
        "app/workbench/vendor/workflowproof/_support.py",
        "app/workbench/vendor/workflowproof/core.py",
        "config/build-inputs.json",
        "config/rwkv-user-assistant.jinja",
        "docs/repository-integrations.md",
        "native/rwkv_state.cpp",
        "pixi.lock",
        "requirements-workbench.txt",
        "scripts/build_state_adapter.py",
        "scripts/package_workbench.py",
        "scripts/project_workshop.py",
        "scripts/verify_workbench.py",
        "scripts/workbench.py",
        "tests/test_patch_staging.py",
        "tests/test_workbench_baseline.py",
        "tests/test_workbench_context.py",
        "tests/test_workbench_integrations.py",
        "tests/test_workbench_receipts.py",
        "tests/test_workbench_state.py",
        "workbench.workflow.json"
      ],
      "outputs": [
        "build/workbench-tests.json"
      ],
      "timeout_seconds": 120,
      "cache": false
    },
    {
      "id": "package-sources",
      "command": [
        "{python}",
        "-m",
        "scripts.package_workbench",
        "build/omarchy-workbench.tar.gz"
      ],
      "verify": [
        "{python}",
        "-m",
        "scripts.package_workbench",
        "build/omarchy-workbench.tar.gz",
        "--verify"
      ],
      "needs": [
        "verify-integrations"
      ],
      "inputs": [
        ".gitattributes",
        "app/config.py",
        "app/container_runner.py",
        "app/git_workspace.py",
        "app/goose_response.py",
        "app/patch_promotion.py",
        "app/patch_tasks.py",
        "app/source_library.py",
        "app/validation_policy.py",
        "app/workbench/__init__.py",
        "app/workbench/baseline.py",
        "app/workbench/builds.py",
        "app/workbench/context.py",
        "app/workbench/integrations.py",
        "app/workbench/qualification.py",
        "app/workbench/receipts.py",
        "app/workbench/state.py",
        "app/workbench/vendor/SOURCES.json",
        "app/workbench/vendor/__init__.py",
        "app/workbench/vendor/mojo-sieve-LICENSE",
        "app/workbench/vendor/mojo-symdex-LICENSE",
        "app/workbench/vendor/sieve.py",
        "app/workbench/vendor/symdex.py",
        "app/workbench/vendor/traceseal/LICENSE",
        "app/workbench/vendor/traceseal/NOTICE",
        "app/workbench/vendor/traceseal/__init__.py",
        "app/workbench/vendor/traceseal/_support.py",
        "app/workbench/vendor/traceseal/core.py",
        "app/workbench/vendor/workflowproof/LICENSE",
        "app/workbench/vendor/workflowproof/NOTICE",
        "app/workbench/vendor/workflowproof/__init__.py",
        "app/workbench/vendor/workflowproof/_support.py",
        "app/workbench/vendor/workflowproof/core.py",
        "config/build-inputs.json",
        "config/rwkv-user-assistant.jinja",
        "docs/repository-integrations.md",
        "native/rwkv_state.cpp",
        "pixi.lock",
        "requirements-workbench.txt",
        "scripts/build_state_adapter.py",
        "scripts/package_workbench.py",
        "scripts/project_workshop.py",
        "scripts/verify_workbench.py",
        "scripts/workbench.py",
        "tests/test_patch_staging.py",
        "tests/test_workbench_baseline.py",
        "tests/test_workbench_context.py",
        "tests/test_workbench_integrations.py",
        "tests/test_workbench_receipts.py",
        "tests/test_workbench_state.py",
        "workbench.workflow.json"
      ],
      "outputs": [
        "build/omarchy-workbench.tar.gz"
      ],
      "timeout_seconds": 30,
      "cache": false
    }
  ]
}
